digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.3, ranksep=0.35];
node [shape=box, style="rounded,filled", fontname="Times New Roman", fontsize=11, color="#2F5597", fillcolor="#EAF2F8", margin="0.12,0.08"];
edge [fontname="Times New Roman", fontsize=9, color="#555555"];
start [label="Начало", shape=oval, fillcolor="#E2F0D9", color="#548235"];
end [label="Завершение", shape=oval, fillcolor="#FCE4D6", color="#C65911"];
n1 [label="Открыть файл: Files.newBufferedReader(path)\nв try-with-resources" ,shape=parallelogram,fillcolor="#E4DFEC",color="#7030A0"];
n2 [label="Файл доступен" ,shape=diamond,fillcolor="#FFF2CC",color="#BF9000"];
n2b [label="Пропустить заголовок (строка 1)"];
n3 [label="Читать следующую строку reader.readLine(),\nномер строки + 1"];
n4 [label="Есть строка" ,shape=diamond,fillcolor="#FFF2CC",color="#BF9000"];
n4b [label="Строка пустая" ,shape=diamond,fillcolor="#FFF2CC",color="#BF9000"];
n5 [label="A1 Разобрать строку parse (ровно 3 поля через ;),\nпроверить validate (ИНН 10 или 12 цифр, наименование 1-25 символов,\nemail с одним @), проверить, что ИНН еще не импортирован"];
n6 [label="Строка корректна" ,shape=diamond,fillcolor="#FFF2CC",color="#BF9000"];
n7 [label="Сохранить Client в репозиторий, accepted + 1"];
n8 [label="Записать ImportError(номер строки, причина)"];
n9 [label="A2 Вернуть ImportResult: принято accepted,\nотклонено errors.size() со списком ошибок"];
n10 [label="IOException уходит наверх:\nимпорт прерван целиком"];
start -> n1;
n1 -> n2;
n2 -> n2b [label="да"];
n2 -> n10 [label="нет"];
n2b -> n3;
n3 -> n4;
n4 -> n4b [label="да"];
n4 -> n9 [label="нет"];
n4b -> n3 [label="да"];
n4b -> n5 [label="нет"];
n5 -> n6;
n6 -> n7 [label="да"];
n6 -> n8 [label="нет"];
n7 -> n3;
n8 -> n3;
n9 -> end;
n10 -> end;
}
